# Caliber production secrets — copy to `.env.production` (gitignored) on the VPS
# and fill in. Referenced by docker-compose.yml's `env_file`. NEVER commit the
# filled-in version. Secrets go here, never in compose `environment:` args.

# First admin — created/updated by `npm run db:seed` on first deploy (fail-loud
# if unset). This account owns all pre-existing single-user data after the
# user_id backfill migration (0009).
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# OpenRouter API key — all LLM calls (scoring, jd-extract, tailor, answers).
OPENROUTER_API_KEY=sk-or-...

# Global daily LLM spend cap in USD (the worker pauses claiming when the day's
# job_scores cost hits this). GLOBAL across all users for now (per the locked
# decision) — make it per-user before the first paying stranger registers.
CALIBER_DAILY_LLM_USD=5

# NOTE: DATABASE_URL (embedded SQLite file on the `dbdata` volume),
# CALIBER_UPLOADS_DIR, SESSION_COOKIE_SECURE are set in docker-compose.yml
# (non-secret), not here. No DB password exists — SQLite is a local file.
#
# ⚠️ PRE-PUBLIC TRIPWIRES (address before exposing beyond you + trusted testers):
#   - Registration is OPEN (no invite code) and there is NO email verification —
#     every account spends real OpenRouter money. Add an invite/allowlist gate.
#   - Sessions have NO expiry (a leaked token is valid until logout). Add a TTL.
#   These are locked-decision behaviors, flagged here so they aren't forgotten.

# Registration invite gate (membership spec) — rotate to invalidate
CALIBER_INVITE_CODE=
