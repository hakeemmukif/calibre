# Postgres connection string (drizzle-orm/pg-core + drizzle-kit). Tests use PGlite instead — see src/server/persistence/test-db.ts.
DATABASE_URL=postgres://user:password@localhost:5432/caliber

# Bootstrap admin — created/updated by `npm run db:seed` (fail-loud if unset). This account owns all pre-existing single-user data after the user_id backfill migration.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-locally
# Session cookie Secure flag. Leave true (or unset) in prod so the cookie is HTTPS-only. Set to false ONLY for local http dev.
SESSION_COOKIE_SECURE=true

# Absolute path to the résumé/upload storage root (fail-loud if unset; dev: an absolute path to a local dir; VPS: /var/lib/caliber/uploads bind-mounted).
CALIBER_UPLOADS_DIR=/absolute/path/to/caliber-uploads
